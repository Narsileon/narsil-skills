import { create } from "zustand";

type CartItem = {
  id: string;
  label: string;
  quantity: number;
};

type CartStoreState = {
  items: CartItem[];
};

type CartStoreActions = {
  addItem: (item: CartItem) => void;
  removeItem: (id: string) => void;
};

type CartStoreType = CartStoreState & CartStoreActions;

const useCartStore = create<CartStoreType>(function (set) {
  return {
    items: [],
    addItem: function addItem(item) {
      set(function (state) {
        return {
          items: [...state.items, { id: item.id, label: item.label, quantity: item.quantity }],
        };
      });
    },
    removeItem: function removeItem(id) {
      set(function (state) {
        return {
          items: state.items.filter(function (item) {
            return item.id !== id;
          }),
        };
      });
    },
  };
});

export { useCartStore };

export type { CartItem };
