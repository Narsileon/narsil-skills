import { cva } from "class-variance-authority";

const cardRootVariants = cva("flex min-w-0 flex-col", {
  defaultVariants: {
    variant: "default",
  },
  variants: {
    variant: {
      default: "rounded-none border-0 bg-transparent",
      outline: "rounded-md border border-border shadow-md",
    },
  },
});

export default cardRootVariants;
