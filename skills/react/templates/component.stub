import { cn } from "@ui/lib/utils";
import { type VariantProps } from "class-variance-authority";
import { type ComponentProps } from "react";
import cardRootVariants from "./card-root-variants";

type CardRootProps = ComponentProps<"div"> &
  VariantProps<typeof cardRootVariants>;

function CardRoot({
  children,
  className,
  variant = "default",
  ...props
}: CardRootProps) {
  return (
    <div
      data-slot="card-root"
      className={cn(cardRootVariants({ variant: variant }), className)}
      {...props}
    >
      {children}
    </div>
  );
}

export default CardRoot;
