#!/usr/bin/env bash

set -u

script_name="$(basename "$0")"
paths=()

usage() {
    printf 'Usage: %s [FILE|DIRECTORY ...]\n' "$script_name"
    printf '\n'
    printf 'Lint PHP files and check the mechanically verifiable PHP skill rules.\n'
    printf 'Without paths, lint tracked PHP files in the current project.\n'
}

failures=0
successes=0

while (($# > 0)); do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
        *)
            paths+=("$1")
            ;;
    esac

    shift
done

if ! command -v php >/dev/null 2>&1; then
    printf 'PHP is required but was not found in PATH.\n' >&2
    exit 2
fi

if ! command -v grep >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
    printf 'grep and awk are required but were not found in PATH.\n' >&2
    exit 2
fi

php_files=()

if ((${#paths[@]} == 0)); then
    if command -v git >/dev/null 2>&1 && git rev-parse --show-toplevel >/dev/null 2>&1; then
        while IFS= read -r file; do
            php_files+=("$file")
        done < <(git ls-files --cached --others --exclude-standard '*.php')
    else
        while IFS= read -r file; do
            php_files+=("$file")
        done < <(find . -type d -name vendor -prune -o -type f -name '*.php' -print)
    fi
else
    for path in "${paths[@]}"; do
        if [[ -d "$path" ]]; then
            while IFS= read -r file; do
                php_files+=("$file")
            done < <(find "$path" -type d -name vendor -prune -o -type f -name '*.php' -print)
        elif [[ -f "$path" ]]; then
            php_files+=("$path")
        else
            printf 'Path not found: %s\n' "$path" >&2
            failures=$((failures + 1))
        fi
    done
fi

if ((${#php_files[@]} == 0)); then
    printf 'No PHP files found.\n'
fi

if ((${#php_files[@]} > 0)); then
    for file in "${php_files[@]}"; do
        if php_lint_output="$(php -l "$file" 2>&1)"; then
            :
        else
            printf 'FAIL syntax: %s\n%s\n' "$file" "$php_lint_output"
            failures=$((failures + 1))
            continue
        fi

        file_failures=0

        if grep -Eq '(^|[^[:alnum:]_])(class|interface|trait|enum)([[:space:]]|$)' "$file"; then
            if [[ "$(sed -n '1p' "$file")" != '<?php' || "$(sed -n '2p' "$file")" != '' || "$(sed -n '3p' "$file")" != 'declare(strict_types=1);' ]]; then
                printf 'FAIL strict types: %s (expected <?php, a blank line, then declare(strict_types=1);)\n' "$file"
                printf '  %s:1: %s\n' "$file" "$(sed -n '1p' "$file")"
                printf '  %s:2: %s\n' "$file" "$(sed -n '2p' "$file")"
                printf '  %s:3: %s\n' "$file" "$(sed -n '3p' "$file")"
                file_failures=$((file_failures + 1))
            fi

            forbidden_matches="$(grep -nE '(^|[[:space:]])//[[:space:]]*region([[:space:]]|$)|(^|[^[:alnum:]_])fn[[:space:]]*\(' "$file" || true)"
            if [[ -n "$forbidden_matches" ]]; then
                printf 'FAIL forbidden syntax: %s (// region comments and arrow functions are not allowed)\n' "$file"
                printf '%s\n' "$forbidden_matches" | sed "s#^#  $file:#"
                file_failures=$((file_failures + 1))
            fi

            private_final_matches="$(grep -nE '(^|[^[:alnum:]_])private[[:space:]]+final[[:space:]]+(const|function|[A-Za-z_])' "$file" || true)"
            if [[ -n "$private_final_matches" ]]; then
                printf 'FAIL private final member: %s\n' "$file"
                printf '%s\n' "$private_final_matches" | sed "s#^#  $file:#"
                file_failures=$((file_failures + 1))
            fi

            non_final_constant_matches="$(grep -nE '(^|[^[:alnum:]_])(public|protected)[[:space:]]+const([[:space:]]|$)' "$file" || true)"
            if [[ -n "$non_final_constant_matches" ]]; then
                printf 'FAIL missing final: %s (public/protected constants must be final)\n' "$file"
                printf '%s\n' "$non_final_constant_matches" | sed "s#^#  $file:#"
                file_failures=$((file_failures + 1))
            fi

            empty_region_line="$(awk '
                /#region[[:space:]]+[A-Z_]+[[:space:]]*$/ { in_region = 1; next }
                in_region && /^[[:space:]]*#endregion[[:space:]]*$/ { print NR; exit }
                in_region && !/^[[:space:]]*$/ { in_region = 0 }
            ' "$file")"
            if [[ -n "$empty_region_line" ]]; then
                printf 'FAIL empty region: %s\n' "$file"
                printf '  %s:%s: empty region\n' "$file" "$empty_region_line"
                file_failures=$((file_failures + 1))
            fi

            constructor_line="$(awk '
                /function[[:space:]]+__construct[[:space:]]*\(/ {
                    in_constructor = 1
                    constructor_line = NR
                    constructor = substr($0, index($0, "(") + 1)
                    next
                }
                in_constructor {
                    constructor = constructor $0
                    if ($0 ~ /\)/) {
                        if (constructor ~ /(^|[^[:alnum:]_])(public|protected|private)[[:space:]]+/) {
                            print constructor_line
                            exit
                        }
                        in_constructor = 0
                        constructor = ""
                    }
                }
            ' "$file")"
            if [[ -n "$constructor_line" ]]; then
                printf 'FAIL constructor promotion: %s\n' "$file"
                printf '  %s:%s: constructor parameters use property promotion\n' "$file" "$constructor_line"
                file_failures=$((file_failures + 1))
            fi
        fi

        if ((file_failures == 0)); then
            successes=$((successes + 1))
        else
            failures=$((failures + 1))
        fi
    done
fi

if [[ ! -f composer.json ]]; then
    printf 'FAIL autoload: composer.json not found in current directory.\n' >&2
    failures=$((failures + 1))
elif ! command -v composer >/dev/null 2>&1; then
    printf 'FAIL autoload: Composer is required.\n' >&2
    failures=$((failures + 1))
else
    if composer_output="$(composer dump-autoload --no-interaction 2>&1)"; then
        successes=$((successes + 1))
    else
        printf 'FAIL autoload: composer dump-autoload\n'
        printf '%s\n' "$composer_output" >&2
        failures=$((failures + 1))
    fi
fi

printf '\nSuccess: %d\nFailed: %d\n' "$successes" "$failures"

if ((failures > 0)); then
    exit 1
fi
