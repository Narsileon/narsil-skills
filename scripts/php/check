#!/usr/bin/env php
<?php

declare(strict_types=1);

$scriptDirectory = __DIR__;
$paths = array_slice($argv, 1);
$successes = 0;
$failures = 0;
$phpFiles = [];

if (in_array('--help', $paths, true) || in_array('-h', $paths, true))
{
    printf("Usage: %s [FILE|DIRECTORY ...]\n\nRun the PHP syntax, style, region, and Composer checks.\n", basename(__FILE__));

    exit(0);
}

foreach ($paths as $path)
{
    if (is_dir($path))
    {
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS));

        foreach ($iterator as $file)
        {
            if ($file->isFile() && $file->getExtension() === 'php' && strpos($file->getPathname(), DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR) === false)
            {
                $phpFiles[] = $file->getPathname();
            }
        }

        continue;
    }

    if (is_file($path))
    {
        $phpFiles[] = $path;

        continue;
    }

    printf("FAIL path: %s not found.\n", $path);

    $failures++;
}

if ($paths === [])
{
    exec("git ls-files --cached --others --exclude-standard '*.php' 2>/dev/null", $phpFiles, $gitStatus);

    if ($gitStatus !== 0)
    {
        $phpFiles = [];
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator('.', FilesystemIterator::SKIP_DOTS));

        foreach ($iterator as $file)
        {
            if ($file->isFile() && $file->getExtension() === 'php' && strpos($file->getPathname(), DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR) === false)
            {
                $phpFiles[] = $file->getPathname();
            }
        }
    }
}

$phpFiles = array_values(array_unique($phpFiles));

foreach ($phpFiles as $file)
{
    foreach (['check-syntax', 'check-style', 'check-phpdoc', 'check-regions'] as $check)
    {
        $status = 0;
        passthru(escapeshellarg($scriptDirectory . '/checks/' . $check) . ' ' . escapeshellarg($file), $status);

        if ($status === 0)
        {
            $successes++;
        }
        else
        {
            $failures++;
        }

        if ($check === 'check-syntax' && $status !== 0)
        {
            break;
        }
    }
}

$composerStatus = 0;

passthru(escapeshellarg($scriptDirectory . '/checks/check-composer'), $composerStatus);

if ($composerStatus === 0)
{
    $successes++;
}
else
{
    $failures++;
}

printf("\nSuccess: %d\nFailed: %d\n", $successes, $failures);

exit($failures > 0 ? 1 : 0);
