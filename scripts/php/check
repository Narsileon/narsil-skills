#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../../src/Enums/CheckEnum.php';
require_once __DIR__ . '/status.php';

#region USE

use Narsil\Skills\Enums\CheckEnum;

#endregion

$scriptDirectory = __DIR__;
$paths = array_slice($argv, 1);
$failures = 0;
$phpFiles = [];

if (in_array('--help', $paths, true) || in_array('-h', $paths, true))
{
    printf("Usage: %s [FILE|DIRECTORY ...]\n\nRun the PHP syntax, style, region, and Composer checks.\n", basename(__FILE__));

    exit(0);
}

foreach ($paths as $path)
{
    if (is_dir($path))
    {
        $excludedDirectories = array_values(array_filter([
            realpath($path . DIRECTORY_SEPARATOR . 'vendor'),
            realpath($path . DIRECTORY_SEPARATOR . 'node_modules'),
        ]));
        $directoryIterator = new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS);
        $filteredIterator = new RecursiveCallbackFilterIterator($directoryIterator, static function (SplFileInfo $file) use ($excludedDirectories): bool
        {
            $realPath = realpath($file->getPathname()) ?: $file->getPathname();

            foreach ($excludedDirectories as $excludedDirectory)
            {
                if ($realPath === $excludedDirectory)
                {
                    return false;
                }
            }

            return true;
        });
        $iterator = new RecursiveIteratorIterator($filteredIterator);

        foreach ($iterator as $file)
        {
            $realPath = realpath($file->getPathname()) ?: $file->getPathname();

            $isExcluded = false;

            foreach ($excludedDirectories as $excludedDirectory)
            {
                if (str_starts_with($realPath, $excludedDirectory . DIRECTORY_SEPARATOR))
                {
                    $isExcluded = true;

                    break;
                }
            }

            if ($file->isFile() && $file->getExtension() === 'php' && !str_ends_with($realPath, '.blade.php') && !$isExcluded)
            {
                $phpFiles[] = $file->getPathname();
            }
        }

        continue;
    }

    if (is_file($path))
    {
        $phpFiles[] = $path;

        continue;
    }

    printf("FAIL path: %s not found.\n", $path);

    $failures++;
}

if ($paths === [])
{
    exec("git ls-files --cached --others --exclude-standard '*.php' 2>/dev/null", $phpFiles, $gitStatus);

    if ($gitStatus !== 0)
    {
        $phpFiles = [];
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator('.', FilesystemIterator::SKIP_DOTS));

        foreach ($iterator as $file)
        {
            if ($file->isFile() && $file->getExtension() === 'php' && !str_ends_with($file->getPathname(), '.blade.php') && strpos($file->getPathname(), DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR) === false)
            {
                $phpFiles[] = $file->getPathname();
            }
        }
    }
}

$phpFiles = array_values(array_unique($phpFiles));

if ($phpFiles !== [])
{
    $pintPath = getcwd() . '/vendor/bin/pint';
    $pintConfig = dirname(__DIR__, 2) . '/pint.json';

    if (!is_file($pintPath) || !is_file($pintConfig))
    {
        printf("FAIL Pint: vendor/bin/pint or the shared Pint configuration was not found.\n");
        printStatusBadge(passed: false, label: 'Pint');

        $failures++;
    }
    else
    {
        $arguments = implode(' ', array_map('escapeshellarg', $phpFiles));
        $ansiOption = '';
        $pintStatus = 0;

        if (stream_isatty(STDOUT) && getenv('NO_COLOR') === false && getenv('TERM') !== 'dumb')
        {
            $ansiOption = '--ansi ';
        }

        passthru(escapeshellarg($pintPath) . ' --test ' . $ansiOption . '--config=' . escapeshellarg($pintConfig) . ' ' . $arguments, $pintStatus);

        if ($pintStatus !== 0)
        {
            $failures++;
            printStatusBadge(passed: false, label: 'Pint');
        }
    }
}

foreach (CheckEnum::cases() as $check)
{
    if ($phpFiles === [])
    {
        continue;
    }

    $arguments = implode(' ', array_map('escapeshellarg', $phpFiles));
    $status = 0;
    passthru(escapeshellarg($scriptDirectory . '/checks/' . $check->value) . ' ' . $arguments, $status);

    if ($status !== 0)
    {
        $failures++;
        printStatusBadge(passed: false, label: $check->value);
    }
}

$composerStatus = 0;

passthru(escapeshellarg($scriptDirectory . '/checks/check-composer'), $composerStatus);

if ($composerStatus !== 0)
{
    $failures++;
    printStatusBadge(passed: false, label: 'check-composer');
}

exit($failures > 0 ? 1 : 0);
