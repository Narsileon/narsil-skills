#!/usr/bin/env php
<?php

declare(strict_types=1);

$failures = 0;

foreach (array_slice($argv, 1) as $file)
{
    $tokens = token_get_all((string)file_get_contents($file));
    $isEnum = false;
    $hasCasesRegion = false;

    foreach ($tokens as $index => $token)
    {
        if (!is_array($token))
        {
            continue;
        }

        $isEnum = $isEnum || $token[0] === T_ENUM;

        if ($token[0] !== T_COMMENT || preg_match('/^#region\s+CASES$/', trim($token[1])) !== 1)
        {
            continue;
        }

        $hasCasesRegion = true;
        $previous = $index - 1;

        while ($previous >= 0 && is_array($tokens[$previous]) && $tokens[$previous][0] === T_WHITESPACE)
        {
            $previous--;
        }

        if (is_array($tokens[$previous] ?? null) && $tokens[$previous][0] === T_DOC_COMMENT)
        {
            printf("FAIL enum regions: %s:%d: CASES region cannot follow PHPDoc\n", $file, $token[2]);

            $failures++;
        }
    }

    if ($isEnum && !$hasCasesRegion)
    {
        printf("FAIL enum regions: %s: enum is missing CASES region\n", $file);

        $failures++;
    }
}

exit($failures > 0 ? 1 : 0);
