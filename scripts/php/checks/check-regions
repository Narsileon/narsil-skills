#!/usr/bin/env php
<?php

declare(strict_types=1);

$paths = array_slice($argv, 1);
$regionOrder = [
    'USE' => 10,
    'CASES' => 20,
    'CONSTRUCTOR' => 30,
    'CONSTANTS' => 40,
    'PROPERTIES' => 50,
    'RELATIONSHIPS' => 60,
    'PUBLIC METHODS' => 70,
    'PROTECTED METHODS' => 80,
    'PRIVATE METHODS' => 90,
];
$memberRegions = ['CONSTRUCTOR', 'CONSTANTS', 'PROPERTIES', 'PUBLIC METHODS', 'PROTECTED METHODS', 'PRIVATE METHODS'];
$failures = 0;

foreach ($paths as $file)
{
    $tokens = token_get_all((string)file_get_contents($file));
    $regionStack = [];
    $lastRegionOrder = 0;
    $members = [];
    $isEnum = false;
    $hasCasesRegion = false;
    $braceDepth = 0;
    $classDepth = null;

    foreach ($tokens as $index => $token)
    {
        $tokenId = is_array($token) ? $token[0] : null;
        $tokenText = is_array($token) ? $token[1] : $token;
        $line = is_array($token) ? $token[2] : 0;

        if (in_array($tokenId, [T_CLASS, T_ENUM, T_INTERFACE, T_TRAIT], true))
        {
            $next = $index + 1;

            while ($next < count($tokens) && is_array($tokens[$next]) && $tokens[$next][0] === T_WHITESPACE)
            {
                $next++;
            }

            if (isset($tokens[$next]) && is_array($tokens[$next]) && $tokens[$next][0] === T_STRING)
            {
                $classDepth = $braceDepth + 1;
            }
        }

        if ($tokenText === '{')
        {
            $braceDepth++;
        }

        if ($tokenText === '}')
        {
            $braceDepth--;

            if ($classDepth !== null && $braceDepth < $classDepth)
            {
                $classDepth = null;
            }
        }

        if (!is_array($token))
        {
            continue;
        }

        if ($tokenId === T_ENUM)
        {
            $isEnum = true;
        }

        if ($tokenId === T_COMMENT && preg_match('/^#region\s+(.+)$/', trim($tokenText), $matches) === 1)
        {
            $region = trim($matches[1]);

            $previousTokenIndex = $index - 1;

            while ($previousTokenIndex >= 0 && is_array($tokens[$previousTokenIndex]) && $tokens[$previousTokenIndex][0] === T_WHITESPACE)
            {
                $previousTokenIndex--;
            }

            if ($region === 'CASES' && is_array($tokens[$previousTokenIndex] ?? null) && $tokens[$previousTokenIndex][0] === T_DOC_COMMENT)
            {
                printf("FAIL regions: %s:%d: CASES region cannot follow PHPDoc\n", $file, $line);

                $failures++;
            }

            if ($region === 'CASES')
            {
                $hasCasesRegion = true;
            }

            if (str_starts_with($region, '• '))
            {
                if ($regionStack === [])
                {
                    printf("FAIL regions: %s:%d: nested region '%s' has no parent region\n", $file, $line, $region);

                    $failures++;
                }

                $regionStack[] = $region;

                continue;
            }

            $currentRegionOrder = $regionOrder[$region] ?? null;

            if ($currentRegionOrder !== null && $currentRegionOrder <= $lastRegionOrder)
            {
                printf("FAIL regions: %s:%d: region '%s' is out of order\n", $file, $line, $region);

                $failures++;
            }

            if ($currentRegionOrder !== null)
            {
                $lastRegionOrder = $currentRegionOrder;
            }

            $regionStack[] = $region;

            continue;
        }

        if ($tokenId === T_COMMENT && trim($tokenText) === '#endregion')
        {
            array_pop($regionStack);

            continue;
        }

        $currentRegion = $regionStack[count($regionStack) - 1] ?? '';

        if ($currentRegion === '' || !in_array($currentRegion, $memberRegions, true) || $tokenId !== T_FUNCTION || $classDepth === null || $braceDepth !== $classDepth)
        {
            continue;
        }

        for ($lookAheadIndex = $index + 1, $tokenCount = count($tokens); $lookAheadIndex < $tokenCount; $lookAheadIndex++)
        {
            $lookAheadToken = $tokens[$lookAheadIndex];

            if (is_array($lookAheadToken) && $lookAheadToken[0] === T_STRING)
            {
                $hasAbstract = false;
                $hasStatic = false;

                for ($modifierIndex = $index - 1; $modifierIndex >= 0; $modifierIndex--)
                {
                    $modifierToken = $tokens[$modifierIndex];

                    if (!is_array($modifierToken) || $modifierToken[0] !== T_WHITESPACE)
                    {
                        if (is_array($modifierToken) && $modifierToken[0] === T_ABSTRACT)
                        {
                            $hasAbstract = true;
                        }

                        if (is_array($modifierToken) && $modifierToken[0] === T_STATIC)
                        {
                            $hasStatic = true;
                        }

                        if (!is_array($modifierToken) || !in_array($modifierToken[0], [T_ABSTRACT, T_FINAL, T_PRIVATE, T_PROTECTED, T_PUBLIC, T_READONLY, T_STATIC], true))
                        {
                            break;
                        }
                    }
                }

                $kind = $hasAbstract && $hasStatic ? 0 : ($hasStatic ? 1 : ($hasAbstract ? 2 : 3));
                $members[$currentRegion][] = ['kind' => $kind, 'name' => $lookAheadToken[1], 'line' => $line];

                break;
            }

            if ((!is_array($lookAheadToken) && $lookAheadToken === '(') || (is_array($lookAheadToken) && $lookAheadToken[1] === '('))
            {
                break;
            }
        }
    }

    foreach ($members as $region => $regionMembers)
    {
        $previousKind = null;
        $previousName = '';

        foreach ($regionMembers as $member)
        {
            if ($previousKind !== null && ($member['kind'] < $previousKind || ($member['kind'] === $previousKind && strcasecmp($member['name'], $previousName) < 0)))
            {
                printf("FAIL regions: %s:%d: %s '%s' is out of alphabetical order after '%s'\n", $file, $member['line'], $region, $member['name'], $previousName);

                $failures++;
            }

            $previousName = $member['name'];
            $previousKind = $member['kind'];
        }
    }

    if ($isEnum && !$hasCasesRegion)
    {
        printf("FAIL regions: %s: enum is missing CASES region\n", $file);

        $failures++;
    }
}

exit($failures > 0 ? 1 : 0);
