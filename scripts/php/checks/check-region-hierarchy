#!/usr/bin/env php
<?php

declare(strict_types=1);

$failures = 0;

foreach (array_slice($argv, 1) as $file)
{
    $stack = [];

    foreach (token_get_all((string)file_get_contents($file)) as $token)
    {
        if (!is_array($token) || $token[0] !== T_COMMENT)
        {
            continue;
        }

        $comment = trim($token[1]);

        if (preg_match('/^#region\s+(.+)$/', $comment, $matches) === 1)
        {
            $region = trim($matches[1]);

            if (str_starts_with($region, '• ') && $stack === [])
            {
                printf("FAIL region hierarchy: %s:%d: nested region '%s' has no parent region\n", $file, $token[2], $region);

                $failures++;
            }

            $stack[] = ['name' => $region, 'line' => $token[2]];

            continue;
        }

        if ($comment !== '#endregion')
        {
            continue;
        }

        if ($stack === [])
        {
            printf("FAIL region hierarchy: %s:%d: region close has no open region\n", $file, $token[2]);

            $failures++;

            continue;
        }

        array_pop($stack);
    }

    foreach ($stack as $region)
    {
        printf("FAIL region hierarchy: %s:%d: region '%s' is not closed\n", $file, $region['line'], $region['name']);

        $failures++;
    }
}

exit($failures > 0 ? 1 : 0);
