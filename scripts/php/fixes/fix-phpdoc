#!/usr/bin/env php
<?php

declare(strict_types=1);

$paths = array_slice($argv, 1);
$files = [];

foreach ($paths as $path)
{
    if (is_dir($path))
    {
        $excludedDirectories = array_values(array_filter([
            realpath($path . DIRECTORY_SEPARATOR . 'vendor'),
            realpath($path . DIRECTORY_SEPARATOR . 'node_modules'),
        ]));
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS));

        foreach ($iterator as $file)
        {
            $realPath = realpath($file->getPathname()) ?: $file->getPathname();

            if ($file->isFile() && $file->getExtension() === 'php' && !str_ends_with($realPath, '.blade.php') && !array_filter($excludedDirectories, static function (string $excludedDirectory) use ($realPath): bool
            {
                return str_starts_with($realPath, $excludedDirectory . DIRECTORY_SEPARATOR);
            }))
            {
                $files[] = $file->getPathname();
            }
        }

        continue;
    }

    if (is_file($path))
    {
        $files[] = $path;
    }
}

foreach (array_values(array_unique($files)) as $file)
{
    $contents = (string) file_get_contents($file);
    $tokens = token_get_all($contents);
    $enumDepth = null;
    $braceDepth = 0;
    $caseLines = [];

    foreach ($tokens as $token)
    {
        $id = is_array($token) ? $token[0] : null;
        $line = is_array($token) ? $token[2] : 0;

        if ($id === T_ENUM)
        {
            $enumDepth = $braceDepth + 1;
        }

        if ($token === '{')
        {
            $braceDepth++;
        }

        if ($token === '}')
        {
            if ($enumDepth === $braceDepth)
            {
                $enumDepth = null;
            }

            $braceDepth--;
        }

        if ($id === T_CASE && $enumDepth === $braceDepth)
        {
            $caseLines[] = $line;
        }
    }

    if ($caseLines === [])
    {
        continue;
    }

    $lines = file($file, FILE_IGNORE_NEW_LINES);

    foreach (array_reverse($caseLines) as $caseLine)
    {
        $lineIndex = $caseLine - 1;
        $indent = preg_replace('/\S.*/', '', $lines[$lineIndex]) ?? '';
        $previousLine = $lines[$lineIndex - 1] ?? '';

        if (trim($previousLine) === '/** @var string */')
        {
            array_splice($lines, $lineIndex - 1, 1, [
                $indent . '/**',
                $indent . ' * @var string',
                $indent . ' */',
            ]);

            continue;
        }

        if (trim($previousLine) === '*/')
        {
            continue;
        }

        array_splice($lines, $lineIndex, 0, [
            $indent . '/**',
            $indent . ' * @var string',
            $indent . ' */',
        ]);
    }

    $hasCasesRegion = false;

    foreach ($lines as $line)
    {
        if (trim($line) === '#region CASES')
        {
            $hasCasesRegion = true;

            break;
        }
    }

    if (!$hasCasesRegion)
    {
        $firstCaseIndex = null;
        $lastCaseIndex = null;

        foreach ($lines as $lineIndex => $line)
        {
            if (preg_match('/^\s*case\s+/', $line) !== 1)
            {
                continue;
            }

            if ($firstCaseIndex === null)
            {
                $firstCaseIndex = $lineIndex;
            }

            $lastCaseIndex = $lineIndex;
        }

        if ($firstCaseIndex !== null && $lastCaseIndex !== null)
        {
            $indent = preg_replace('/\S.*/', '', $lines[$firstCaseIndex]) ?? '';
            array_splice($lines, $firstCaseIndex, 0, [$indent . '#region CASES', '']);
            $lastCaseIndex += 2;
            array_splice($lines, $lastCaseIndex + 1, 0, ['', $indent . '#endregion']);
        }
    }

    foreach ($lines as $lineIndex => $line)
    {
        if (trim($line) !== '#region CASES' || trim($lines[$lineIndex - 1] ?? '') !== '*/')
        {
            continue;
        }

        $docStart = $lineIndex - 1;

        while ($docStart >= 0 && trim($lines[$docStart]) !== '/**')
        {
            $docStart--;
        }

        if ($docStart < 0)
        {
            continue;
        }

        $docblock = array_splice($lines, $docStart, $lineIndex - $docStart);
        $regionIndex = $lineIndex - count($docblock);
        array_splice($lines, $regionIndex + 1, 0, array_merge([''], $docblock));

        break;
    }

    foreach ($lines as $regionIndex => $line)
    {
        if (trim($line) !== '#region CASES')
        {
            continue;
        }

        $firstCaseIndex = null;
        $docblocks = [];
        $docStart = null;

        for ($lineIndex = $regionIndex + 1, $lineCount = count($lines); $lineIndex < $lineCount; $lineIndex++)
        {
            if (preg_match('/^\s*case\s+/', $lines[$lineIndex]) === 1)
            {
                $firstCaseIndex = $lineIndex;

                break;
            }

            if (trim($lines[$lineIndex]) === '/**')
            {
                $docStart = $lineIndex;
            }

            if ($docStart !== null && trim($lines[$lineIndex]) === '*/')
            {
                $docblocks[] = [$docStart, $lineIndex];
                $docStart = null;
            }
        }

        if ($firstCaseIndex === null || count($docblocks) < 2)
        {
            break;
        }

        foreach (array_reverse(array_slice($docblocks, 0, -1)) as $docblock)
        {
            array_splice($lines, $docblock[0], $docblock[1] - $docblock[0] + 1);
        }

        while (($lines[$regionIndex + 1] ?? '') === '' && ($lines[$regionIndex + 2] ?? '') === '')
        {
            array_splice($lines, $regionIndex + 1, 1);
        }

        break;
    }

    file_put_contents($file, implode(PHP_EOL, $lines) . PHP_EOL);
}
