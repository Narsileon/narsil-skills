#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../../../src/Enums/RegionEnum.php';

use Narsil\Skills\Enums\RegionEnum;

$files = [];

foreach (array_slice($argv, 1) as $path)
{
    if (is_dir($path))
    {
        $excludedDirectories = array_values(array_filter([
            realpath($path . DIRECTORY_SEPARATOR . 'vendor'),
            realpath($path . DIRECTORY_SEPARATOR . 'node_modules'),
        ]));
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS));

        foreach ($iterator as $file)
        {
            $realPath = realpath($file->getPathname()) ?: $file->getPathname();

            if ($file->isFile() && $file->getExtension() === 'php' && !str_ends_with($realPath, '.blade.php') && !array_filter($excludedDirectories, static function (string $excludedDirectory) use ($realPath): bool
            {
                return str_starts_with($realPath, $excludedDirectory . DIRECTORY_SEPARATOR);
            }))
            {
                $files[] = $file->getPathname();
            }
        }

        continue;
    }

    if (is_file($path))
    {
        $files[] = $path;
    }
}

foreach (array_values(array_unique($files)) as $file)
{
    $contents = (string)file_get_contents($file);
    $lines = preg_split('/\R/', rtrim($contents, "\r\n"));
    $updatedLines = [];
    $stack = [];
    $lastClosedRegion = null;

    foreach ($lines as $line)
    {
        $indent = preg_replace('/\S.*/', '', $line) ?? '';
        $skipLine = false;

        if (preg_match('/^\s*#region\s+(.+)$/', $line, $matches) === 1)
        {
            $region = trim($matches[1]);

            if (str_starts_with($region, '• ') && $stack === [] && $lastClosedRegion !== null && RegionEnum::tryFrom($lastClosedRegion['name'])?->isMember())
            {
                for ($previousIndex = count($updatedLines) - 1; $previousIndex >= 0; $previousIndex--)
                {
                    if (preg_match('/^\s*#endregion\s*$/', $updatedLines[$previousIndex]) !== 1)
                    {
                        continue;
                    }

                    array_splice($updatedLines, $previousIndex, 1);

                    break;
                }

                $stack[] = $lastClosedRegion;
            }

            if (RegionEnum::tryFrom($region)?->isMember() && $stack !== [] && !str_starts_with($stack[count($stack) - 1]['name'], '• '))
            {
                if ($updatedLines !== [] && trim($updatedLines[count($updatedLines) - 1]) !== '')
                {
                    $updatedLines[] = '';
                }

                $updatedLines[] = $stack[count($stack) - 1]['indent'] . '#endregion';
                $updatedLines[] = '';
                $lastClosedRegion = array_pop($stack);
            }

            if (RegionEnum::tryFrom($region)?->isMember() && $stack === [])
            {
                $lastClosedRegion = null;
            }

            $stack[] = ['indent' => $indent, 'name' => $region];
        }

        if (preg_match('/^\s*#endregion\s*$/', $line) === 1 && $stack === [])
        {
            $skipLine = true;
        }
        elseif (preg_match('/^\s*#endregion\s*$/', $line) === 1)
        {
            $lastClosedRegion = array_pop($stack);
        }

        if (preg_match('/^(\s*)}\s*$/', $line, $closingMatches) === 1)
        {
            while ($stack !== [] && strlen($closingMatches[1]) < strlen($stack[count($stack) - 1]['indent']))
            {
                if ($updatedLines !== [] && trim($updatedLines[count($updatedLines) - 1]) !== '')
                {
                    $updatedLines[] = '';
                }

                $updatedLines[] = $stack[count($stack) - 1]['indent'] . '#endregion';
                array_pop($stack);
            }
        }

        if (!$skipLine)
        {
            $updatedLines[] = $line;
        }
    }

    if ($updatedLines !== $lines)
    {
        file_put_contents($file, implode(PHP_EOL, $updatedLines) . PHP_EOL);
    }
}
