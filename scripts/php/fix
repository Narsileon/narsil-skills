#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/status.php';

$scriptDirectory = __DIR__;
$paths = array_slice($argv, 1);

if (in_array('--help', $paths, true) || in_array('-h', $paths, true))
{
    printf("Usage: %s [FILE|DIRECTORY ...]\n\nRun the PHP automatic fixers.\n", basename(__FILE__));

    exit(0);
}

$fixers = [
    'fix-arrow-functions',
    'fix-phpdoc',
    'fix-region-hierarchy',
    'fix-regions',
    'fix-member-order',
    'fix-regions',
    'fix-method-order',
];

foreach ($fixers as $fixer)
{
    passthru(escapeshellarg($scriptDirectory . '/fixes/' . $fixer) . ($paths === [] ? '' : ' ' . implode(' ', array_map('escapeshellarg', $paths))), $status);

    printStatusBadge(passed: $status === 0, label: $fixer);

    if ($status !== 0)
    {
        exit($status);
    }
}

if ($paths !== [])
{
    $pintPath = getcwd() . '/vendor/bin/pint';
    $pintConfig = dirname(__DIR__, 2) . '/pint.json';

    if (!is_file($pintPath) || !is_file($pintConfig))
    {
        fwrite(STDERR, "Pint could not be found with the shared configuration.\n");
        printStatusBadge(passed: false, label: 'Pint', toStandardError: true);

        exit(1);
    }

    $ansiOption = '';

    if (stream_isatty(STDOUT) && getenv('NO_COLOR') === false && getenv('TERM') !== 'dumb')
    {
        $ansiOption = '--ansi ';
    }

    passthru(escapeshellarg($pintPath) . ' ' . $ansiOption . '--config=' . escapeshellarg($pintConfig) . ' ' . implode(' ', array_map('escapeshellarg', $paths)), $status);
    printStatusBadge(passed: $status === 0, label: 'Pint');
}

exit($status);
